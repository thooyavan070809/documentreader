# Copy this file to .env for local development.
# Never commit real credentials.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-local-secret

# Groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Qdrant Cloud
QDRANT_URL=https://replace-with-your-cluster-url
QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_COLLECTION=enterprise_knowledge

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# Local metadata and file storage
METADATA_DATABASE_URL=sqlite:///./data/app.db
UPLOAD_ROOT=./data/uploads

# Retrieval and ingestion defaults
MAX_UPLOAD_MB=50
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
DENSE_CANDIDATE_LIMIT=20
SPARSE_CANDIDATE_LIMIT=20
FINAL_CONTEXT_LIMIT=8
MIN_RETRIEVAL_SCORE=0.35

LOG_LEVEL=INFO
