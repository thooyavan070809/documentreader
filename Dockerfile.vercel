FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/huggingface \
    METADATA_DATABASE_URL=sqlite:////tmp/enterprise-rag.db \
    UPLOAD_ROOT=/tmp/uploads

WORKDIR /app

COPY pyproject.toml README.md ./
COPY app ./app
COPY domain ./domain
COPY ingestion ./ingestion
COPY rag ./rag
COPY storage ./storage
COPY ui ./ui
COPY web ./web
COPY server.py ./server.py

# Install PyTorch from its CPU-only index first. The default Linux wheel can
# pull several gigabytes of CUDA libraries that are unused by this CPU service
# and can exhaust Vercel's container-build disk before the image is committed.
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.4,<3" && \
    pip install . && \
    python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-base-en-v1.5')"

EXPOSE 80

CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT:-80}"]
